# Copy to .env (local) or add in Netlify > Site settings > Environment variables
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Usernames are turned into emails with this domain (e.g. tariq -> tariq@dha-mt.local)
VITE_LOGIN_DOMAIN=dha-mt.local
